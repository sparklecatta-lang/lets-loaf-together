[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/action_preview_window.gd" id="1_preview"]
[ext_resource type="Theme" path="res://themes/companion_theme.tres" id="2_theme"]

[node name="ActionPreviewWindow" type="Window"]
title = "动作预览"
size = Vector2i(430, 650)
min_size = Vector2i(360, 420)
visible = false
always_on_top = true
force_native = true
wrap_controls = true
theme = ExtResource("2_theme")
script = ExtResource("1_preview")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
